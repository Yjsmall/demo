{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-ucrt64",
      "displayName": "Development - MSYS2 UCRT64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-ucrt64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/msys2-ucrt64.cmake",
        "CONTEXT_READER_BUILD_NODE": "OFF",
        "CONTEXT_READER_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-ucrt64",
      "configurePreset": "dev-ucrt64"
    }
  ],
  "testPresets": [
    {
      "name": "dev-ucrt64",
      "configurePreset": "dev-ucrt64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
