{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-ucrt64",
      "displayName": "Development - MSYS2 UCRT64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-ucrt64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/msys2-ucrt64.cmake",
        "CONTEXT_READER_BUILD_NODE": "OFF",
        "CONTEXT_READER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "p1-ucrt64",
      "displayName": "P1 - MuPDF 1.28.3",
      "inherits": "dev-ucrt64",
      "binaryDir": "${sourceDir}/build/p1-ucrt64",
      "cacheVariables": {
        "CONTEXT_READER_BUILD_TOOLS": "ON",
        "CONTEXT_READER_ENABLE_MUPDF": "ON",
        "CONTEXT_READER_MUPDF_ROOT": "${sourceDir}/build/mupdf-1.28.3"
      }
    },
    {
      "name": "p2-ucrt64",
      "displayName": "P2 - Workspace vertical slice",
      "inherits": "p1-ucrt64",
      "binaryDir": "${sourceDir}/build/p2-ucrt64",
      "cacheVariables": {
        "CONTEXT_READER_ENABLE_WORKSPACE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-ucrt64",
      "configurePreset": "dev-ucrt64"
    },
    {
      "name": "p1-ucrt64",
      "configurePreset": "p1-ucrt64"
    },
    {
      "name": "p2-ucrt64",
      "configurePreset": "p2-ucrt64"
    }
  ],
  "testPresets": [
    {
      "name": "dev-ucrt64",
      "configurePreset": "dev-ucrt64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "p1-ucrt64",
      "configurePreset": "p1-ucrt64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "p2-ucrt64",
      "configurePreset": "p2-ucrt64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
